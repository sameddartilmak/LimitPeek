{
  "name": "usage-notch",
  "version": "0.6.39",
  "private": true,
  "description": "Windows tray monitor for AI coding tool usage limits.",
  "main": "src/main/index.js",
  "scripts": {
    "build": "node src/renderer/build.mjs --prod",
    "prestart": "node src/renderer/build.mjs",
    "start": "electron .",
    "test": "npm run typecheck && node --test \"test/**/*.test.js\"",
    "verify:render": "electron test/render/run.js",
    "icon": "node scripts/make-icon.js",
    "scan": "node scripts/scan-once.js",
    "smoke": "electron scripts/smoke-ipc.js",
    "audit:needed": "node scripts/audit-needed.js",
    "canary:cli": "node scripts/real-cli-canary/run.js",
    "typecheck": "tsc -p src/renderer/tsconfig.json --noEmit",
    "dist:dir": "npm run typecheck && npm run build && node scripts/write-build-info.js && electron-builder --win --dir --publish never",
    "dist": "npm run typecheck && npm run build && node scripts/write-build-info.js && electron-builder --win nsis --publish never",
    "store:assets": "electron scripts/make-store-assets.js"
  },
  "devDependencies": {
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "typescript": "5.9.3"
  },
  "build": {
    "appId": "com.usagenotch.app",
    "productName": "LimitPeek",
    "asar": true,
    "asarUnpack": [
      "bridge/**",
      "node_modules/@koromix/koffi-win32-x64/**"
    ],
    "files": [
      "package.json",
      "src/main/**",
      "src/core/**",
      "src/shared/**",
      "src/renderer/index.html",
      "src/renderer/dist/**",
      "src/renderer/styles/**",
      "src/renderer/assets/**",
      "bridge/**",
      "assets/**",
      "!src/renderer/dev/**",
      "!src/renderer/dist/renderer/dev/**",
      "!src/renderer/dist/**/dev/**",
      "!src/renderer/src/**",
      "!src/renderer/build.mjs",
      "!src/renderer/tsconfig.json",
      "!**/*.ts",
      "!test/**",
      "!scripts/**",
      "!node_modules/koffi/{doc,lib,vendor}/**",
      "!node_modules/koffi/build/**",
      "!node_modules/koffi/src/koffi/src/abi/**",
      "!node_modules/koffi/src/koffi/src/*.{cc,hh,inc,def}",
      "!node_modules/koffi/src/koffi/CMakeLists.txt",
      "!node_modules/koffi/{cnoke.cjs,index.d.ts,index.js,indirect.js,CHANGELOG.md,README.md}",
      "!node_modules/koffi/src/koffi/{index.js,indirect.js,src/static.js,src/trampolines.js}",
      "!node_modules/@koromix/koffi-!(win32-x64)/**",
      "!node_modules/@koromix/koffi-win32-x64/**/*.lib"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "include": "build/installer.nsh",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "appx": {
      "customExtensionsPath": "build/appx-extensions.xml",
      "displayName": "LimitPeek",
      "publisherDisplayName": "LimitPeek",
      "languages": [
        "en-US",
        "tr-TR"
      ]
    }
  },
  "dependencies": {
    "koffi": "3.3.3"
  }
}
