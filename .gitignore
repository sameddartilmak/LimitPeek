# Bağımlılıklar. 405 MB, ve package-lock.json zaten sürümleri sabitliyor.
node_modules/

# Derleme çıktısı. `npm start` bunu `prestart` ile kendisi üretir. Depoda bayat
# bir kopya tutmak hiç tutmamaktan kötüdür: `renderer-build.test.js` tam olarak
# "kaynak düzenlendi ama yeniden derlenmedi" halini yakalamak için var.
src/renderer/dist/

# Paketleyici çıktısı (electron-builder temizleyip yeniden üretir).
dist/

# Makineye özel. Köprü kurucusu buraya MUTLAK bir yol yazıyor, yani commit'lenen
# bir kopya tek bir geliştiricinin ev dizinini gösterir ve herkeste bozulur.
.claude/settings.json
.claude/settings.local.json

# Orkestratör koşu günlükleri: oturuma özel, ve komut metni içeriyorlar.
agent-orchestrator/logs/

*.log

# landing page: generated screenshots
site/screenshots/

# Render koşusunun çıktısı: makineye ve koşuya özel, her koşuda üzerine yazılır.
render-out.txt

# Paketleme sırasında yazılır (scripts/write-build-info.js); commit edilirse hep bir önceki commit'i anlatır.
src/main/build-info.json

# Sahibin özel notları: satış, marka başvuruları, tasarım raporları. Bilgisayarda
# kalır, açık kaynak depoya girmez.
docs/satis-plani.md
docs/landing-plan.md
docs/apple-tasarim-raporu.md
docs/marka-izin-basvurulari*.md
docs/ekran-goruntuleri/
.claude/
